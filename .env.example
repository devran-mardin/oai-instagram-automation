# Sunucu portu (Railway kendi PORT değerini otomatik enjekte eder, lokalde 3000 kullanılır)
PORT=3000

# Bilgi amaçlı, kodda kullanılmıyor
INSTAGRAM_ACCOUNT_HANDLE=otomasyon_ai

# Meta Webhook doğrulama jetonu — kendi belirlediğin rastgele bir metin,
# Meta Developer Portal > Webhooks kısmına aynısını gireceksin
VERIFY_TOKEN=

# Meta Developer Portal > App Settings > Basic > App Secret
# Webhook isteklerinin gerçekten Meta'dan geldiğini doğrulamak için kullanılır (X-Hub-Signature-256)
META_APP_SECRET=

# Instagram/Facebook Sayfa Erişim Jetonu (Meta Graph API)
PAGE_ACCESS_TOKEN=

# OpenAI API anahtarı (platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
